# ============================================================
# AI Meeting Automation — Environment Variables Reference
# Copy this file to .env in each service directory and fill in.
# ============================================================


# ────────────────────────────────────────────────────────────
# [backend] Required
# ────────────────────────────────────────────────────────────

# Claude API (AI 분석)
# LLM 공급자: "gemini" | "anthropic" (미설정 시 GEMINI_API_KEY가 있으면 gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# 기본 gemini-3.8-flash. 더 저렴하게: gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.8-flash
# 혼잡(503)·한도(429) 시 모델당 시도 횟수와 예비 모델(쉼표로 여러 개)
GEMINI_MAX_ATTEMPTS=4
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# LLM_PROVIDER=anthropic 일 때만 필요
ANTHROPIC_API_KEY=

# Slack (알림 발송)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ────────────────────────────────────────────────────────────
# [backend] STT
# ────────────────────────────────────────────────────────────

# "whisper-api" (기본, OpenAI 키 필요) | "local" (로컬 Whisper 모델)
STT_BACKEND=whisper-api
OPENAI_API_KEY=sk-...
# 설정 시 OpenAI 대신 Groq Whisper(whisper-large-v3) 사용
GROQ_API_KEY=

# API 전사 시 긴 녹음을 나누는 단위(초). API 25MB 제한을 넘지 않도록 자동 보정
STT_CHUNK_SECONDS=600

# STT_BACKEND=local 일 때 사용할 Whisper 모델 크기
# tiny | base | small | medium | large (클수록 정확하지만 느림)
WHISPER_LOCAL_MODEL=base

# ────────────────────────────────────────────────────────────
# [backend] Integrations (선택)
# ────────────────────────────────────────────────────────────

# Jira · Confluence (워크플로 10·12·13, 선택) — docs/OPERATIONS.md "Jira·Confluence 연결"
# 같은 Atlassian 사이트·토큰을 함께 씁니다. 제품별로 다르면 JIRA_*/CONFLUENCE_* 로 덮어쓰기.
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
# 비워두면 그 제품은 연결하지 않음. 검색·생성은 이 프로젝트/스페이스 안에서만
JIRA_PROJECT_KEY=
CONFLUENCE_SPACE_KEY=
# 이슈 유형 이름 (기본 Task — 사이트 언어에 따라 "작업"일 수 있음)
JIRA_ISSUE_TYPE=
# 회의록을 이 페이지 아래에 생성 (선택)
CONFLUENCE_MEETING_PARENT_PAGE_ID=
JIRA_WEBHOOK_SECRET=

# Slack 검색 (Retrieval)
SLACK_SEARCH_CHANNEL=general

# ────────────────────────────────────────────────────────────
# [backend] Security & Rate Limiting
# ────────────────────────────────────────────────────────────

# 백엔드 API 키 (빈 값이면 인증 비활성화)
BACKEND_API_KEY=

# 업로드 Rate Limit: 클라이언트 IP당 WINDOW초 내 최대 LIMIT회
# (웹 프록시가 API 키와 함께 보낸 X-Client-IP 기준)
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW=60

# [backend] 최초 관리자 계정 (사용자가 없을 때만 생성, 비밀번호 10자 이상)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# [backend] 세션 유지 시간(시간)
SESSION_TTL_HOURS=12

# [recording-page] 로그인 실패 제한: IP당 15분 내 실패 횟수 초과 시 429
AUTH_MAX_FAILURES=20
# [recording-page] 클라이언트 IP 헤더. 비우면 X-Forwarded-For의 마지막 값(플랫폼 프록시가 추가) 사용.
# 플랫폼 엣지가 직접 설정·덮어쓰는 헤더일 때만 지정 (예: true-client-ip)
CLIENT_IP_HEADER=

# ────────────────────────────────────────────────────────────
# [backend] Storage & Monitoring
# ────────────────────────────────────────────────────────────

# 처리 후 원본 녹음(.wav)·원문 전사(.transcript.json) 보관 여부 (기본 false: 삭제·미저장)
RETAIN_RAW_RECORDINGS=false
# 회의 보존 기간(일). 지나면 시작 시·6시간마다 자동 삭제. 0이면 끔
MEETING_RETENTION_DAYS=0

STORAGE_DIR=./data/recordings

# 이상 탐지 임계치
ALERT_FAILURE_RATE=0.3
ALERT_MIN_CONFIDENCE=0.5

# ────────────────────────────────────────────────────────────
# [recording-page] Next.js
# ────────────────────────────────────────────────────────────

# 백엔드 업로드 URL (서버 사이드 프록시용 — 브라우저에 노출되지 않음)
UPLOAD_API_URL=http://localhost:8000
BACKEND_API_KEY=

# ────────────────────────────────────────────────────────────
# [slack-bot]
# ────────────────────────────────────────────────────────────

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=

# 녹화 페이지 URL (Slack 버튼 링크)
RECORDING_PAGE_URL=http://localhost:3001

# Microsoft Graph API (캘린더 연동)
AZURE_CLIENT_ID=
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

PORT=3000
NODE_ENV=development
DEFAULT_TIMEZONE=Asia/Seoul

# [backend] 승인 후 Slack 게시 시 근무시간 판단에 쓰는 팀 시간대 (쉼표로 여러 개 → 다수결)
WORKSPACE_TIMEZONES=Asia/Seoul

# [slack-bot] 워크플로 1~3: 캘린더 감지 → Slack DM → 녹음 준비
# Google "iCal 형식의 비공개 주소" 또는 Outlook 게시 캘린더 ICS 링크 (쉼표로 여러 개, 비밀값)
CALENDAR_ICS_URLS=
# 장소 없는(온라인) 회의도 알림 대상에 포함
CALENDAR_INCLUDE_ONLINE=false
# Socket Mode 앱 수준 토큰 (connections:write)
SLACK_APP_TOKEN=
# [slack-bot + recording-page] Slack DM 녹음 링크 서명 키 (둘이 같은 값, 긴 임의 문자열)
RECORDING_LINK_SECRET=

# [backend] 워크플로 20~21: 아침 브리핑·주간 다이제스트 (Slack 설정 시 자동)
BRIEFING_ENABLED=true
BRIEFING_TIME=09:00
# 브리핑 채널 (없으면 SLACK_BRIEF_CHANNEL)
DIGEST_CHANNEL=
# 담당자 이름 → Slack 사용자 ID 멘션 (선택)
SLACK_USER_MAP=

# [backend] 워크플로 22: 품질 경고·주간 품질 리포트를 받을 관리자 채널 ID (비우면 화면에만 표시)
MONITOR_ALERT_CHANNEL=
ALERT_FAILURE_RATE=0.3
ALERT_MIN_CONFIDENCE=0.6
